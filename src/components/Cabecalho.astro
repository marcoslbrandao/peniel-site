---
import Icone from './Icone.astro';
import { MENU, rota } from '../lib/rotas';
import { LINKS } from '../lib/config';
interface Props { atual?: string }
const { atual = '' } = Astro.props;
---
<header class="topo">
  <div class="wrap">
    <a class="marca" href={rota()} aria-label="Peniel Church, página inicial">
      <img src={rota('img/logo.png')} alt="" width="44" height="44" />
      <span>
        <span class="marca-nome">Peniel Church</span>
        <span class="marca-local">Reading · UK</span>
      </span>
    </a>

    <nav class="nav" aria-label="Principal">
      {MENU.map((m) => (
        <a href={rota(m.href)} aria-current={m.href === atual ? 'page' : undefined}>{m.rotulo}</a>
      ))}
    </nav>

    <div class="topo-acoes">
      <a class="idioma" href={rota('#live-translation')} lang="en">EN</a>
      <a class="btn btn-navy" href={LINKS.app}>
        <Icone nome="celular" tam={16} />
        <span>Baixar <span class="rotulo-longo">o </span>app</span>
      </a>
      <details class="menu-movel">
        <summary aria-label="Abrir menu"><Icone nome="menu" tam={20} cor="#1A1740" /></summary>
        <nav class="menu-painel" aria-label="Menu">
          {MENU.map((m) => (
            <a href={rota(m.href)} aria-current={m.href === atual ? 'page' : undefined}>{m.rotulo}</a>
          ))}
          <a href={rota('#live-translation')} lang="en">Live translation (EN)</a>
        </nav>
      </details>
    </div>
  </div>
</header>

<script>
  // Fecha o menu do celular ao tocar num link ou fora dele.
  const menu = document.querySelector<HTMLDetailsElement>('.menu-movel');
  if (menu) {
    menu.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => (menu.open = false)));
    document.addEventListener('click', (e) => {
      if (menu.open && !menu.contains(e.target as Node)) menu.open = false;
    });
  }
</script>
