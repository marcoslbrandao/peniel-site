---
// Ficha de visitante — o destino do QR Code dos cartazes e do telão.
// Mesma Edge Function da página antiga (docs/visitante.html do app):
// `visitante-publico`, que grava em `visitantes` e cuida de armadilha,
// tempo mínimo e limite por IP. Quem preenche aqui entra com consentimento.
import Base from '../layouts/Base.astro';
import TopoPagina from '../components/TopoPagina.astro';
import Icone from '../components/Icone.astro';
import { LINKS, SUPABASE_URL } from '../lib/config';

const COMO = ['Um amigo convidou', 'Família', 'Internet', 'Passando na rua', 'Um evento', 'Outro'];
---
<Base atual="" titulo="Bem-vindo · Peniel Church" descricao="Deixe seu contato e receba as boas-vindas da Peniel Church." semIndice>
  <TopoPagina sobretitulo="Primeira vez aqui?" titulo="Que bom ter você aqui" lead="Deixe seu contato para a gente dar as boas-vindas durante a semana. Leva menos de um minuto." />

  <section class="secao visitante" style="padding-bottom:84px">
    <div class="wrap">
      <form class="cartao formulario" data-visitante data-url={`${SUPABASE_URL}/functions/v1/visitante-publico`} novalidate>
        <p class="form-status erro" data-erro hidden role="alert"></p>

        <div class="campo">
          <label for="nome">Seu nome *</label>
          <input id="nome" name="nome" autocomplete="name" required maxlength="120" />
        </div>

        <div class="campo">
          <label for="telefone">WhatsApp</label>
          <input id="telefone" name="telefone" type="tel" autocomplete="tel" placeholder="07700 900123" maxlength="30" />
          <small>É por aqui que mandamos as boas-vindas. Pode escrever do jeito que você usa.</small>
        </div>

        <div class="campo">
          <span class="pergunta" id="rotulo-primeira">É a sua primeira vez na Peniel?</span>
          <div class="pilulas duas" data-grupo="primeira" role="group" aria-labelledby="rotulo-primeira">
            <button type="button" class="pilula" data-v="sim" aria-pressed="true">Sim</button>
            <button type="button" class="pilula" data-v="nao" aria-pressed="false">Já vim antes</button>
          </div>
        </div>

        <div class="campo">
          <span class="pergunta" id="rotulo-como">Como você chegou até nós?</span>
          <div class="pilulas" data-grupo="como" data-vazio role="group" aria-labelledby="rotulo-como">
            {COMO.map((c) => <button type="button" class="pilula" aria-pressed="false">{c}</button>)}
          </div>
        </div>

        <div class="campo">
          <label for="obs">Quer nos contar mais alguma coisa?</label>
          <textarea id="obs" name="obs" maxlength="1000" placeholder="Um pedido de oração, com quem você veio, o que achou…"></textarea>
        </div>

        <div class="privacidade">
          <Icone nome="escudo" tam={16} traco={2} />
          <span>Seus dados ficam só com a liderança da Peniel Church e servem para entrarmos em contato. Não compartilhamos com ninguém, e você pode pedir para removermos quando quiser.</span>
        </div>

        <!-- Armadilha para robôs: pessoas não veem este campo. -->
        <div class="armadilha" aria-hidden="true"><label for="website">Deixe em branco</label><input id="website" name="website" tabindex="-1" autocomplete="off" /></div>

        <button class="btn btn-navy" type="submit" data-enviar>Enviar meu contato</button>
      </form>

      <div class="cartao ok" data-ok hidden>
        <div class="circulo"><Icone nome="check" tam={40} cor="#27AE60" traco={2.5} /></div>
        <h2 data-ok-titulo>Recebemos, obrigado!</h2>
        <p data-ok-texto>A nossa liderança entra em contato durante a semana. Foi uma alegria ter você conosco.</p>
        <a class="btn btn-navy" href={LINKS.app}>Baixar o app da Peniel</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .visitante .wrap { max-width: 600px; }
  .pergunta { font-size: 14px; font-weight: 600; color: var(--texto); }
  .pilulas { display: flex; flex-wrap: wrap; gap: 8px; }
  .pilulas.duas .pilula { flex: 1; }
  .pilula { font: inherit; font-size: 14.5px; min-height: 44px; padding: 9px 16px; border-radius: 999px; border: 1px solid var(--borda); background: var(--bg); color: var(--texto-2); cursor: pointer; transition: background .12s ease, border-color .12s ease, color .12s ease; }
  .pilula[aria-pressed="true"] { background: var(--roxo-claro); border-color: var(--roxo-2); color: var(--roxo-2); font-weight: 600; }
  .privacidade { display: flex; gap: 10px; align-items: flex-start; background: var(--bg); border-radius: 12px; padding: 13px 14px; font-size: 13px; line-height: 1.5; color: var(--texto-2); }
  .privacidade :global(svg) { flex: none; margin-top: 2px; }
  .ok[hidden] { display: none; }
  .ok { text-align: center; padding: 40px 28px; display: flex; flex-direction: column; align-items: center; gap: 14px; }
  .ok .circulo { width: 84px; height: 84px; border-radius: 50%; background: var(--verde-claro); display: flex; align-items: center; justify-content: center; }
  .ok h2 { font-size: 26px; }
  .ok p { margin: 0 0 8px; color: var(--texto-2); max-width: 380px; }
</style>

<script>
  const form = document.querySelector<HTMLFormElement>('[data-visitante]');
  if (form) {
    const abertoEm = Date.now();
    const erro = form.querySelector<HTMLElement>('[data-erro]')!;
    const botao = form.querySelector<HTMLButtonElement>('[data-enviar]')!;
    const ok = document.querySelector<HTMLElement>('[data-ok]')!;

    // Pílulas de escolha única: mostram todas as opções de uma vez no celular.
    form.querySelectorAll<HTMLElement>('[data-grupo]').forEach((grupo) => {
      const permiteVazio = grupo.hasAttribute('data-vazio');
      grupo.addEventListener('click', (e) => {
        const alvo = (e.target as HTMLElement).closest<HTMLElement>('.pilula');
        if (!alvo) return;
        const jaEstava = alvo.getAttribute('aria-pressed') === 'true';
        grupo.querySelectorAll('.pilula').forEach((p) => p.setAttribute('aria-pressed', 'false'));
        alvo.setAttribute('aria-pressed', permiteVazio && jaEstava ? 'false' : 'true');
      });
    });
    const escolhido = (nome: string) =>
      form.querySelector<HTMLElement>(`[data-grupo="${nome}"] .pilula[aria-pressed="true"]`);

    const mostraErro = (texto: string) => {
      erro.textContent = texto;
      erro.hidden = false;
      erro.scrollIntoView({ behavior: 'smooth', block: 'center' });
    };
    const liberaBotao = () => { botao.disabled = false; botao.textContent = 'Enviar meu contato'; };

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      erro.hidden = true;
      const val = (id: string) => (form.querySelector<HTMLInputElement>(`#${id}`)?.value || '').trim();
      const nome = val('nome');
      if (!nome) return mostraErro('Escreva o seu nome para a gente saber quem é você.');

      botao.disabled = true;
      botao.textContent = 'Enviando…';
      try {
        const r = await fetch(form.dataset.url!, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            nome,
            telefone: val('telefone'),
            observacoes: val('obs'),
            primeira_vez: escolhido('primeira')?.dataset.v === 'sim',
            como_conheceu: escolhido('como')?.textContent?.trim() || null,
            website: (form.querySelector<HTMLInputElement>('#website')?.value || ''),
            aberto_em: abertoEm,
          }),
        });
        const corpo = await r.json().catch(() => null);
        if (corpo && corpo.ok) {
          if (corpo.ja_existia) {
            document.querySelector('[data-ok-titulo]')!.textContent = 'Que bom te ver de novo!';
            document.querySelector('[data-ok-texto]')!.textContent = 'Já tínhamos o seu contato. Anotamos que você esteve com a gente outra vez.';
          }
          form.hidden = true;
          ok.hidden = false;
          window.scrollTo({ top: 0, behavior: 'smooth' });
          return;
        }
        liberaBotao();
        mostraErro(r.status === 429
          ? 'Recebemos muitos envios agora há pouco. Espere um minutinho e tente de novo.'
          : 'Não conseguimos enviar agora. Tente de novo, ou fale com alguém da recepção.');
      } catch {
        liberaBotao();
        mostraErro('Sem conexão no momento. Verifique a internet e tente de novo.');
      }
    });
  }
</script>
