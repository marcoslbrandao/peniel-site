---
import '../styles/global.css';
import Cabecalho from '../components/Cabecalho.astro';
import Rodape from '../components/Rodape.astro';
import { rota } from '../lib/rotas';
import { LINKS } from '../lib/config';

interface Props {
  titulo?: string; descricao?: string; atual?: string;
  /** 'article' nas páginas de mensagem; o resto é 'website'. */
  tipo?: 'website' | 'article';
  /** Imagem de compartilhamento própria (ex.: capa da mensagem). */
  imagem?: string | null;
  /** Dados estruturados extras da página (schema.org). */
  dados?: Record<string, unknown> | null;
  /** Páginas que não devem aparecer no Google (404). */
  semIndice?: boolean;
}
const {
  titulo = 'Peniel Church · Igreja de fala portuguesa em Reading, UK',
  descricao = 'Igreja evangélica de fala portuguesa em Reading (UK), com brasileiros e amigos de muitos lugares. Culto aos domingos, 18h, em Abbey Square.',
  atual = '',
  tipo = 'website',
  imagem = null,
  dados = null,
  semIndice = false,
} = Astro.props;
const canonica = new URL(Astro.url.pathname, Astro.site);
const imagemSocial = imagem ? new URL(imagem, Astro.site) : new URL(rota('img/pastores.jpg'), Astro.site);

const igreja = {
  '@context': 'https://schema.org',
  '@type': 'Church',
  name: 'Peniel Church',
  url: canonica.origin + rota(),
  email: LINKS.email,
  logo: new URL(rota('img/logo.png'), Astro.site).href,
  address: { '@type': 'PostalAddress', streetAddress: 'Abbey Square', addressLocality: 'Reading', postalCode: 'RG1 3BE', addressCountry: 'GB' },
  geo: { '@type': 'GeoCoordinates', latitude: 51.4554719, longitude: -0.9672378 },
  image: new URL(rota('img/pastores.jpg'), Astro.site).href,
  description: 'Igreja evangélica de fala portuguesa em Reading, Reino Unido. Culto todo domingo às 18h em Abbey Square, com tradução ao vivo para inglês e espanhol.',
  hasMap: LINKS.mapa,
  knowsLanguage: ['pt-BR', 'en', 'es'],
  sameAs: [LINKS.youtube, LINKS.instagram, LINKS.facebook],
};
const site = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'Peniel Church',
  url: canonica.origin + rota(),
  inLanguage: 'pt-BR',
};
---
<!doctype html>
<html lang="pt-BR">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{titulo}</title>
  <meta name="description" content={descricao} />
  <link rel="canonical" href={canonica} />
  <link rel="icon" type="image/png" href={rota('favicon.png')} />
  <link rel="apple-touch-icon" href={rota('img/logo.png')} />
  <meta name="theme-color" content="#1A1740" />
  {semIndice && <meta name="robots" content="noindex" />}
  <meta property="og:type" content={tipo} />
  <meta property="og:locale" content="pt_BR" />
  <meta property="og:site_name" content="Peniel Church" />
  <meta property="og:title" content={titulo} />
  <meta property="og:description" content={descricao} />
  <meta property="og:url" content={canonica} />
  <meta property="og:image" content={imagemSocial} />
  {!imagem && <meta property="og:image:width" content="1400" />}
  {!imagem && <meta property="og:image:height" content="933" />}
  <meta property="og:image:alt" content={imagem ? titulo : 'Pastores Marcos e Débora Brandão, da Peniel Church'} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={titulo} />
  <meta name="twitter:description" content={descricao} />
  <meta name="twitter:image" content={imagemSocial} />
  <script is:inline>document.documentElement.classList.add('js');</script>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Manrope:wght@500;600;700;800&family=Work+Sans:wght@300;400;500;600&display=swap" />
  {atual === '' && !semIndice && <script type="application/ld+json" set:html={JSON.stringify(site)} />}
  <script type="application/ld+json" set:html={JSON.stringify(igreja)} />
  {dados && <script type="application/ld+json" set:html={JSON.stringify(dados)} />}
</head>
<body>
  <a class="sr-only" href="#conteudo">Pular para o conteúdo</a>
  <Cabecalho atual={atual} />
  <main id="conteudo">
    <slot />
  </main>
  <Rodape />
  <script>
    // Link para fora do site abre em outra aba, para o site continuar aberto.
    // Vale também para links que chegam depois (avisos, textos do banco):
    // por isso, além de marcar os que já existem, confere no clique.
    const externo = (a: HTMLAnchorElement) =>
      /^https?:$/.test(a.protocol) && a.hostname !== location.hostname;
    const abrirFora = (a: HTMLAnchorElement) => {
      if (!externo(a) || a.target) return;
      a.target = '_blank';
      a.rel = [a.rel, 'noopener'].filter(Boolean).join(' ');
    };
    document.querySelectorAll<HTMLAnchorElement>('a[href]').forEach(abrirFora);
    document.addEventListener('click', (ev) => {
      const a = (ev.target as Element | null)?.closest?.('a[href]') as HTMLAnchorElement | null;
      if (a) abrirFora(a);
    }, true);

    const topo = document.querySelector('.topo');
    const aoRolar = () => topo?.classList.toggle('rolou', scrollY > 8);
    addEventListener('scroll', aoRolar, { passive: true });
    aoRolar();

    const reduz = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const alvos = document.querySelectorAll('main > section:not(.hero):not(.destaques)');
    if (reduz || !('IntersectionObserver' in window)) {
      document.documentElement.classList.remove('js');
    } else {
      const io = new IntersectionObserver((itens) => itens.forEach((i) => {
        if (i.isIntersecting) { i.target.classList.add('visivel'); io.unobserve(i.target); }
      }), { rootMargin: '0px 0px -8% 0px' });
      alvos.forEach((el) => { el.classList.add('revela'); io.observe(el); });
    }
  </script>
</body>
</html>
